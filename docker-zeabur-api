# ---- Production Laravel Backend (FrankenPHP) ----
FROM dunglas/frankenphp:1-php8.4-bookworm

# Install required PHP extensions for Laravel (PostgreSQL, MySQL, Zip, etc.)
RUN install-php-extensions \
    pdo_pgsql \
    pgsql \
    pdo_mysql \
    zip \
    pcntl \
    opcache \
    bcmath

# Copy Composer from official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy dependency definitions and install (production only with optimized autoloader)
COPY api/composer.json api/composer.lock* ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader --classmap-authoritative

# Copy application source code
COPY api/ .

# Bangun ulang autoloader SETELAH kode aplikasi disalin: dengan --classmap-authoritative,
# class yang tidak terdaftar (mis. semua controller di app/) tidak akan bisa dimuat
RUN composer dump-autoload --no-dev --no-scripts --optimize --classmap-authoritative \
    && php artisan package:discover --ansi

# Prepare storage directories and grant permissions
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Production Memory & OPcache Optimization for 2GB VPS
RUN echo "memory_limit = 128M" > /usr/local/etc/php/conf.d/memory-limit.ini \
    && { \
        echo "opcache.enable = 1"; \
        echo "opcache.enable_cli = 1"; \
        echo "opcache.memory_consumption = 32"; \
        echo "opcache.interned_strings_buffer = 8"; \
        echo "opcache.max_accelerated_files = 4000"; \
        echo "opcache.validate_timestamps = 0"; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Default Environment Variables (PostgreSQL & Cookie Session seperti di local .env)
ENV DB_CONNECTION=pgsql
ENV SESSION_DRIVER=cookie
ENV CACHE_STORE=file
ENV QUEUE_CONNECTION=sync

# Set HTTP port to 8000
ENV SERVER_NAME=":8000"
EXPOSE 8000

# Cache Laravel configs/routes and run FrankenPHP server
CMD php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache \
    && frankenphp run --config /etc/caddy/Caddyfile
