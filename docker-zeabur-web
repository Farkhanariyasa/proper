# ---- Build Stage (Next.js) ----
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install ALL dependencies including devDependencies (Tailwind, PostCSS, Typescript)
RUN npm install --include=dev

# Copy source code
COPY . .

# Ensure public directory exists
RUN mkdir -p /app/public

# Accept API URL build argument and default to Zeabur API domain
ARG NEXT_PUBLIC_API_URL="https://proper-api.zeabur.app"
ARG API_URL="https://proper-api.zeabur.app"

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_URL=$API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js application (bakes NEXT_PUBLIC_API_URL into client JS bundle)
RUN npm run build

# ---- Production Runner ----
FROM node:22-alpine AS runner

WORKDIR /app

ARG NEXT_PUBLIC_API_URL="https://proper-api.zeabur.app"
ARG API_URL="https://proper-api.zeabur.app"

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_URL=$API_URL
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
# Batasi V8 heap memory agar Node.js tidak boros RAM di server 2GB
ENV NODE_OPTIONS="--max-old-space-size=256"

# Hanya salin bundle standalone dan static assets (tanpa node_modules penuh)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

# Jalankan langsung server.js tanpa overhead npx
CMD ["node", "server.js"]

