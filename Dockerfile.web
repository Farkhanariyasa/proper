# ---- Build Stage (Next.js) ----
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install ALL dependencies including devDependencies (Tailwind, PostCSS, Typescript)
RUN npm install --include=dev

# Copy source code
COPY . .

# Ensure public directory exists
RUN mkdir -p /app/public

# Accept API URL build argument and default to Zeabur API domain
ARG NEXT_PUBLIC_API_URL="https://proper-api.zeabur.app"
ARG API_URL="https://proper-api.zeabur.app"

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_URL=$API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js application (bakes NEXT_PUBLIC_API_URL into client JS bundle)
RUN npm run build

# ---- Production Runner ----
FROM node:22-alpine AS runner

WORKDIR /app

ARG NEXT_PUBLIC_API_URL="https://proper-api.zeabur.app"
ARG API_URL="https://proper-api.zeabur.app"

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_URL=$API_URL
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy package manifests and production artifacts
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
